{
  "name": "riskqueue-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 -m scripts.build_website",
    "format": "prettier --write website tests/web scripts/*.mjs *.json *.js .github/workflows/website.yml",
    "format:check": "prettier --check website tests/web scripts/*.mjs *.json *.js .github/workflows/website.yml",
    "lint": "eslint website tests/web scripts/*.mjs *.js",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test tests/web/domain.test.js",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve_website.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0"
  }
}
