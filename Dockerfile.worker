FROM python:3.12.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY riskqueue ./riskqueue
RUN pip install --no-cache-dir .
COPY sql ./sql

RUN useradd --create-home --uid 10001 riskqueue
USER riskqueue

CMD ["python", "-m", "riskqueue.worker"]
